# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is ignored by Git. Never commit real secrets.

# Database name and user (must match what the APIs connect with)
DB_NAME=quickballot
DB_USER=postgres

# Generate a strong password with: openssl rand -hex 24
DB_PASSWORD=change_me

# Address the BROWSER uses to reach this machine: localhost if the app runs on your own computer, or the server IP/hostname if it runs elsewhere
PUBLIC_HOST=localhost
